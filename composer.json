{
    "name": "portfolio/ticket-hold-legacy-replace",
    "description": "Brownfield: ticket hold domain extraction (DG-AIDLC)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "deptrac/deptrac": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "TicketHold\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TicketHold\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse -c phpstan.neon",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml",
        "check": [
            "@test",
            "@phpstan",
            "@deptrac"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
